<?xml version="1.0"?>
<robot name="drone" xmlns:xacro="http://www.ros.org/wiki/xacro">
  
  <!-- 매개변수 -->
  <xacro:property name="namespace" value="drone"/>
  <xacro:property name="mass" value="1.5"/>
  
  <!-- 메인 본체 -->
  <link name="base_link">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" 
               iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
    <collision>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
    </collision>
    <visual>
      <geometry>
        <box size="0.3 0.3 0.1"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>
  
  <!-- 센서 include -->
  <xacro:include filename="$(find your_package)/urdf/sensors.urdf.xacro"/>
  
  <!-- Gazebo 플러그인 include -->
  <xacro:include filename="$(find your_package)/urdf/drone.gazebo"/>
  
</robot>
